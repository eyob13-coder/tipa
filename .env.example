BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
# Optional: verification provider API keys for server-side verification of
# transfers. Providers are tried in priority order with automatic failover.
# Leave all empty to rely on creator approval only.
VERIFY_ET_API_KEY=
VERIFY_ET_BASE_URL=https://verify.et
CHECK_ET_API_KEY=
CHECK_ET_BASE_URL=https://api.check.et/api/v1
JUSTVERIFY_API_KEY=
JUSTVERIFY_BASE_URL=https://justverify.et
DATABASE_URL=sqlite+aiosqlite:///./tipa.db
PLATFORM_FEE_BIRR=0.0
BOT_USERNAME=TipaPayBot
# Remind the creator to approve a claimed tip after this many hours
TIP_REMINDER_HOURS=24
# Auto-cancel claimed tips not approved within this many hours
TIP_EXPIRY_HOURS=72
# How often the background check runs
TIP_REMINDER_LOOP_MINUTES=30

# --- Tipa Pro subscription ---
# Price and duration shown by /pro
PRO_PRICE_BIRR=199
PRO_DURATION_DAYS=30
# Where creators send the Pro payment (your own wallet/bank account)
TIPA_RECEIVING_METHOD=telebirr
TIPA_RECEIVING_ACCOUNT=
# Comma-separated Telegram user ids allowed to manually approve Pro payments
ADMIN_TELEGRAM_IDS=
